# Non-secret answers for cloud-init and CI.
# CLI options written after --answers override these values.
LANGUAGE=en
PREFIX=/usr/local
PROFILE=quick
ROLE=standalone
CORES=xray,hysteria,telemt
TLS_MODE=auto
FIRST_USER_MODE=recommended
FIRST_USER_NAME=default
FIRST_USER_LIMITS=recommended
FIRST_USER_TRAFFIC=100GB
FIRST_USER_DURATION=30d
FIRST_USER_IPS=2
# Set PUBLIC_HOST for deterministic non-interactive installation.
PUBLIC_HOST=203.0.113.10
UTLS_PROFILE=firefox
# Set a public/decoy name only when every intended Hysteria client supports ECH.
HYSTERIA_ECH=off
